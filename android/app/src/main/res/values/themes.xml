<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 正常界面主题：深色系统栏 + 深色窗口背景，和游戏画面无缝衔接 -->
    <style name="Theme.AshenVow" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/av_ink</item>
        <item name="android:colorBackground">@color/av_ink</item>
        <item name="android:statusBarColor">@color/av_ink</item>
        <item name="android:navigationBarColor">@color/av_ink</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:colorAccent">@color/av_gold</item>
        <item name="android:windowDisablePreview">false</item>
    </style>

    <!-- 启动主题：冷启动第一帧显示品牌徽记，避免白屏 -->
    <style name="Theme.AshenVow.Splash" parent="Theme.AshenVow">
        <item name="android:windowBackground">@drawable/splash_background</item>
    </style>
</resources>
